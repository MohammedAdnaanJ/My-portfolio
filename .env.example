# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (Resend — https://resend.com). Without these the form shows a clear "not configured" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend
CONTACT_FROM_EMAIL=
